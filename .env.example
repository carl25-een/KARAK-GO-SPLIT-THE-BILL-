# Copy this file to ".env" for local use, or set the same variables in your
# hosting provider's dashboard. The server also reads real environment
# variables, which take precedence.

# Port the server listens on (hosting providers set this automatically).
PORT=3000

# Optional staff PIN. When set, editing the café menu and deleting bills
# require this PIN (the app will prompt for it). Leave empty to disable.
STAFF_PIN=

# Optional M-Pesa (Safaricom Daraja) STK Push. Fill ALL of these in to show
# a "Pay with M-Pesa" button on each person's card; if any is missing the
# feature stays off and manual mark-paid is used instead.
# Get credentials from a free app at https://developer.safaricom.co.ke
# (sandbox test shortcode is 174379; its passkey is listed with the Daraja
# test credentials). MPESA_ENV=production switches to live credentials.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public URL Safaricom calls back with the payment result, e.g.
# https://your-host.example/api/mpesa/callback
MPESA_CALLBACK_URL=
